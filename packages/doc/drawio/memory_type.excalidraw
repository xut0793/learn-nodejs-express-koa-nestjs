    {
      "id": "DpN6ozNReXHmbRZV7kYmZ",
      "type": "text",
      "x": 808,
      "y": -132,
      "width": 512,
      "height": 40,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 60,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1874802100,
      "version": 188,
      "versionNonce": 895927564,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1717124964952,
      "link": null,
      "locked": false,
      "text": "易失性 (Volatile) 存储器\n特点是读写速度很快，掉电了数据会丢失，价格贵，并且存储容量较小。",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 34,
      "containerId": null,
      "originalText": "易失性 (Volatile) 存储器\n特点是读写速度很快，掉电了数据会丢失，价格贵，并且存储容量较小。",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 371,
      "versionNonce": 1676838836,
      "isDeleted": false,
      "id": "YWutc8tq8EXZnOS2tSEYg",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 60,
      "angle": 0,
      "x": 1094.2160263061523,
      "y": 443,
      "strokeColor": "#000000",
      "backgroundColor": "#ffc9c9",
      "width": 688,
      "height": 40,
      "seed": 407061900,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1717124858207,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 1,
      "text": "非易失性 (Nonvolatile) 存储器\n与易失性存储器相比，它们读写速度很慢，但是掉电不丢失数据，存储容量比较大，价格也便宜。",
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "非易失性 (Nonvolatile) 存储器\n与易失性存储器相比，它们读写速度很慢，但是掉电不丢失数据，存储容量比较大，价格也便宜。",
      "lineHeight": 1.25,
      "baseline": 34
    },
