        <mxCell id="WQLuI3vA_ZYWuGOhdLaY-223" value="JWT 算法&lt;br&gt;1. header: base64UrlEncode({alg: &#39;HS256&#39;, type:&#39;jwt&#39;})&lt;br&gt;2. payload: base64UrlEncode(payload)&lt;br&gt;3. sign: HS256(header.apyload, secret)&lt;br&gt;4. token: header.payload.sign" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1" vertex="1" parent="WQLuI3vA_ZYWuGOhdLaY-224">
