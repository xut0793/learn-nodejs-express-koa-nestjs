        <mxCell id="WQLuI3vA_ZYWuGOhdLaY-219" value="Digest 算法，默认&amp;nbsp;MD5&lt;br&gt;1. A1: MD5(username:realm:password)&lt;br&gt;2. A2: MD5(method:uri)&lt;br&gt;3. digest = MD5(A1:nonce:nc:cnonce:qop:A2)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1" vertex="1" parent="WQLuI3vA_ZYWuGOhdLaY-222">
          <mxGeometry x="411" width="269" height="70" as="geometry" />
        </mxCell>
        <mxCell id="WQLuI3vA_ZYWuGOhdLaY-220" value="Authorization&amp;nbsp;请求格式：&lt;br&gt;Digest username=&amp;lt;username&amp;gt;, realm=&amp;lt;realm&amp;gt;, &lt;br&gt;qop=&amp;lt;auth,auth-int&amp;gt;, nonce=&amp;lt;nonce&amp;gt;, &lt;br&gt;uri=&amp;lt;uri&amp;gt; nc=&amp;lt;nc&amp;gt;, cnonce=&amp;lt;cnonce&amp;gt;, &lt;br&gt;response=&amp;lt;response&amp;gt;&lt;br&gt;&lt;br&gt;其中&amp;nbsp;reponse&amp;nbsp;就是浏览器生成的摘要，服务器需要&lt;br&gt;根据其它字段信息计算出摘要值与&amp;nbsp;reponse&amp;nbsp;比对&lt;br&gt;相同则通过&lt;br&gt;&lt;br&gt;因为摘要算法中存在 nc&amp;nbsp;和&amp;nbsp;cnonce&amp;nbsp;随机字段&lt;br&gt;所以无法像&amp;nbsp;Basic&amp;nbsp;中自定义登录后，通过 js&amp;nbsp;主动附加&lt;br&gt;请求头" style="text;strokeColor=none;fillColor=none;html=1;fontSize=10;fontStyle=0;verticalAlign=middle;align=left;" vertex="1" parent="WQLuI3vA_ZYWuGOhdLaY-222">
          <mxGeometry x="460" y="383" width="210" height="174" as="geometry" />
        </mxCell>
