{
  // 使用 IntelliSense 了解相关属性。
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debugger Nestjs",
      "request": "launch",
      "runtimeArgs": ["run-script", "start:debug"],
      "runtimeExecutable": "pnpm",
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}/packages/nestjs",
      "type": "node"
    },
    {
      "name": "debugger Node",
      "request": "launch",
      "runtimeArgs": ["run-script", "dev"],
      "runtimeExecutable": "pnpm",
      "cwd": "${workspaceFolder}/packages/node",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "debugger Koa",
      "request": "launch",
      "runtimeArgs": ["run-script", "dev"],
      "runtimeExecutable": "pnpm",
      "cwd": "${workspaceFolder}/packages/koa",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    }
  ]
}
